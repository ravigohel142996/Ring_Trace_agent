__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.env
.pytest_cache/
.streamlit/secrets.toml

# Frontend dependencies and generated production assets
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Local, machine-specific FalkorDB binaries (fetched/built by scripts/setup_falkordb_local.sh)
bin/

# Generated / synthetic data artifacts (regenerate with scripts/run_pipeline.sh)
data/raw/*.csv
data/processed/*
!data/processed/.gitkeep

# Generated reports (regenerate on demand from the dashboard / CLI)
reports/*.md
reports/*.json
reports/*.pdf
!reports/.gitkeep

# Trained model artifacts are small and useful to ship, but allow override
*.log
.DS_Store

# Redis/FalkorDB RDB snapshot dumped by the locally-built redis-server binary
dump.rdb
