# ─────────────────────────────────────────────────────────────
# RingTrace — environment configuration
# Copy this file to `.env` and fill in local demo values only.
# NEVER use production credentials or commit a real .env file (already ignored).
# ─────────────────────────────────────────────────────────────

# ---- FalkorDB (the agent's core reasoning/context layer) ----
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=ringtrace

# ---- LLM tool-calling (optional) ----
# RingTrace works fully WITHOUT an LLM key — it falls back to a deterministic
# rule-based investigation planner so the demo never breaks. Set these to
# enable LLM-driven dynamic tool selection instead.
# Supported providers: "groq", "openai", "none"
LLM_PROVIDER=none
LLM_API_KEY=
# Groq example: https://api.groq.com/openai/v1   model: llama-3.3-70b-versatile
# OpenAI example: https://api.openai.com/v1       model: gpt-4o-mini
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOOL_ITERATIONS=8

# ---- Synthetic data generator (ingestion/generate_synthetic_data.py) ----
RING_COUNT=5
ACCOUNTS_PER_RING=8
LEGIT_PERSON_COUNT=150
NORMAL_TRANSACTION_COUNT=900
NOISE_LEVEL=0.08
FRAUD_RATIO=0.12
RANDOM_SEED=42

# ---- Event-day Time-Respecting Payment-Corridor workflow (disabled by default) ----
# Uses a separate graph name and connection settings; never inherits FALKORDB_PORT.
# Start/verify a disposable loopback database on 6380 before enabling locally.
RINGTRACE_EVENTDAY_ENABLED=0
RINGTRACE_EVENTDAY_DISPOSABLE=0
RINGTRACE_EVENTDAY_FALKORDB_HOST=127.0.0.1
RINGTRACE_EVENTDAY_FALKORDB_PORT=6380
RINGTRACE_EVENTDAY_FALKORDB_USERNAME=
RINGTRACE_EVENTDAY_FALKORDB_PASSWORD=
RINGTRACE_EVENTDAY_FALKORDB_TLS=0
RINGTRACE_EVENTDAY_GRAPH=ringtrace_eventday_local
RINGTRACE_EVENTDAY_DATASET=ringtrace_eventday_synthetic_v1

# ---- Demo analyst authentication (required for action routes; blank fails closed) ----
# Generate a unique signing secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Configure one demo analyst; no defaults or built-in credentials are shipped.
RINGTRACE_AUTH_SECRET=
RINGTRACE_DEMO_USERNAME=
RINGTRACE_DEMO_PASSWORD=
RINGTRACE_SESSION_TTL_SECONDS=28800
RINGTRACE_APPROVAL_TTL_SECONDS=300
# Session cookies default Secure. For localhost over plain HTTP only, explicitly opt out:
# RINGTRACE_AUTH_COOKIE_SECURE=false

# ---- App ----
RINGTRACE_LOG_LEVEL=INFO
